{{ autogen_warning }}#pragma once

#include <cstddef>
#include <cstdint>

namespace ee_schema {

// What every record begins with, and all a walk of the stored image reads:
// the tag says which record, the hash which shape, the size where the next
// one starts.
struct RecordHeader {
  uint32_t magic;
  uint32_t schema_hash;
  uint32_t size;
};

static_assert(sizeof(RecordHeader) == 12);

{% for blob in blobs %}
struct {{ blob.type_name }} {
  static constexpr uint32_t kMagic = {{ blob.magic_hex }};
  static constexpr uint32_t kSchemaHash = {{ blob.schema_hash_hex }};

  uint32_t magic;
  uint32_t schema_hash;
  uint32_t size;
{% for field in blob.fields %}
{% if field.count == 1 %}
  {{ field.cpp_type }} {{ field.name }};
{% else %}
  {{ field.cpp_type }} {{ field.name }}[{{ field.count }}];
{% endif %}
{% endfor %}

  static constexpr bool IsExactSchema(const {{ blob.type_name }} &value) {
    return value.magic == kMagic && value.schema_hash == kSchemaHash &&
           value.size == sizeof({{ blob.type_name }});
  }

  static constexpr void PopulateHeader({{ blob.type_name }} &value) {
    value.magic = kMagic;
    value.schema_hash = kSchemaHash;
    value.size = sizeof({{ blob.type_name }});
  }
};

static_assert(sizeof({{ blob.type_name }}) == {{ blob.expected_size }});
static_assert(sizeof({{ blob.type_name }}) % 4u == 0u);
static_assert(offsetof({{ blob.type_name }}, size) ==
              offsetof(RecordHeader, size));

{% endfor %}
// Every record this firmware knows. A stored record with any other tag is
// one a past firmware wrote, and is dropped when the image is packed.
struct KnownRecord {
  uint32_t magic;
  uint32_t schema_hash;
  uint32_t size;
};

inline constexpr KnownRecord kKnownRecords[] = {
{% for blob in blobs %}
    {{ '{' }}{{ blob.type_name }}::kMagic, {{ blob.type_name }}::kSchemaHash,
     sizeof({{ blob.type_name }}){{ '}' }},
{% endfor %}
};

inline constexpr size_t kKnownRecordCount =
    sizeof(kKnownRecords) / sizeof(kKnownRecords[0]);

// The image with every known record present and nothing else.
inline constexpr size_t kTotalSize = {{ total_size }}u;

} // namespace ee_schema
