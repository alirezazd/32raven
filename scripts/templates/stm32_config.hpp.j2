{# The stall window is bounded at both ends and only one end is checkable.
   Below: PublishHealth stamps ImuHealth on every burst, unconditionally, so
   the window has to span many of them or ordinary jitter reads as a stalled
   sensor and restarts a healthy one mid-flight. Above: it has to stay under
   the time the motors and props need to respond, or the airframe has already
   diverged by the time the stall is noticed -- that bound is a property of
   the airframe, not a constant here, so it lives in this comment. #}
static_assert(kSentinelConfig.imu_stall_timeout_us >=
                  (8u * 1000000u) / kControlLoopHz,
              "STM32_SENTINEL_IMU_STALL_TIMEOUT_MS must span at least 8 IMU "
              "bursts, or loop jitter reads as a stalled sample path");

