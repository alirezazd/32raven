        .limits = {
            .integrator_clamp = {{ rate_controller.integrator_clamp_milli }} * 0.001f,
            .output_clamp = {{ rate_controller.output_clamp_milli }} * 0.001f,
            .i_factor_error_thresh = {{ rate_controller.i_factor_error_thresh_milli }} * 0.001f,
        },
        .smoother = {
            .rate_limit = static_cast<float>({{ axis.sp_rate_limit }}),
            .lpf_alpha = {{ '%.6f' | format(axis.sp_lpf_alpha) }}f,
        },
        .d_term_lpf_alpha = {{ '%.6f' | format(rate_controller.d_term_lpf_alpha) }}f,
    },
{% endfor %}
    .iterm_freeze_below_throttle = {{ rate_controller.iterm_freeze_below_throttle_milli }} * 0.001f,
    .yaw_output_lpf_alpha = {{ '%.6f' | format(rate_controller.yaw_output_lpf_alpha) }}f,
};

{# Mahony complementary-filter gains for the AHRS. All six knobs are
   scaled by 1000 in Kconfig (so menuconfig deals in integers); the
   template folds each into its float representation at the point of
   use. Soft attenuation: accel correction full-trust inside +/-full_dev,
   smooth decay to zero by +/-zero_dev; bias updates full-weight when
   |gyro| <= quiescent_full, smooth decay to zero by quiescent_zero. #}
inline constexpr Ahrs::Config kAhrsConfig = {
    .kp_accel                  = {{ ahrs.kp_accel_milli }} * 0.001f,
    .ki_bias                   = {{ ahrs.ki_bias_milli }} * 0.001f,
    .accel_trust_full_dev_g    = {{ ahrs.accel_trust_full_dev_milli }} * 0.001f,
    .accel_trust_zero_dev_g    = {{ ahrs.accel_trust_zero_dev_milli }} * 0.001f,
    .gyro_quiescent_full_rad_s = {{ ahrs.gyro_quiescent_full_milli }} * 0.001f,
    .gyro_quiescent_zero_rad_s = {{ ahrs.gyro_quiescent_zero_milli }} * 0.001f,
};

{# Outer attitude loop gains (Stage-2 Stabilize mode). Kconfig stores
   kp scaled by 1000 and rate_clamp in milli-rad/s; the template folds
   each into its float representation at the point of use. #}
{# The transmitter's channel number is resolved to a slot here because
   RcData::channels holds only the enabled channels. #}
// Index into RcData::channels, which is compacted to the enabled channels --
// not the transmitter's channel number. Derived from
// CONFIG_STM32_RC_MAP_MODE, which the generator refuses unless
// that channel is enabled.
inline constexpr std::size_t kFlightModeChannelSlot = {{ flight_mode.slot }};
inline constexpr std::uint16_t kFlightModeThresholdUs = {{ flight_mode.threshold_us }};
inline constexpr float kPilotAcroMaxRateRollPitch = {{ flight_mode.acro_max_rate_roll_pitch_milli }} * 0.001f;
inline constexpr float kPilotAcroMaxRateYaw = {{ flight_mode.acro_max_rate_yaw_milli }} * 0.001f;
inline constexpr float kPilotStabilizeMaxTiltRad = {{ flight_mode.stabilize_max_tilt_rad }};

inline constexpr AttitudeController::Config kAttitudeControllerConfig = {
{% for axis_name in ["roll", "pitch", "yaw"] %}
{% set axis = attitude_controller[axis_name] %}
    .{{ axis_name }} = {
        .kp = {{ axis.kp_milli }} * 0.001f,
