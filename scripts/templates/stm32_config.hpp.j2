// Rate the FIFO watermark interrupt drives the control cascade at, and the
// only correct timestep for anything it integrates. Derived from the
// CLKIN-scaled record rate divided by the watermark, and exact by
// construction: the build rejects a rate that does not divide evenly.
inline constexpr std::uint32_t kControlLoopHz = {{ control_loop_hz }}u;
inline constexpr float kControlLoopDtSec = 1.0f / static_cast<float>(kControlLoopHz);

