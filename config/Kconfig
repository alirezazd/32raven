menu "ESC Service"

config STM32_ESC_SERVICE_DSHOT_GAP_BITS
    int "DShot inter-frame gap bits"
    range 0 64
    default 2
    help
      Number of idle bit times inserted between DShot frames.

config STM32_ESC_SERVICE_IDLE_PERIOD_US
    int "Idle frame period (us)"
    range 100 1000000
    default 1000
    help
      Period for sending idle (zero-throttle) DShot frames when disarmed.

config STM32_ESC_SERVICE_COMMAND_PERIOD_US
    int "Command repeat period (us)"
    range 100 1000000
    default 2000
    help
      Period at which queued DShot commands are re-sent until satisfied.

config STM32_ESC_SERVICE_TELEMETRY_REQUEST_PERIOD_US
    int "Telemetry request period (us)"
    range 100 1000000
    default 4000
    help
      Period at which the service requests telemetry from each motor in turn.

config STM32_ESC_SERVICE_COMMAND_REPEAT_COUNT
    int "Command repeat count"
    range 1 64
    default 10
    help
      Number of times each queued DShot command is retransmitted to ensure
      reliable delivery to the ESC.

config STM32_ESC_SERVICE_FIRMWARE_CHECKS
    bool "Check ESC firmware settings"
    default y
    help
      Panic when an ESC reports settings this airframe cannot fly with: an
      input mode that is not DShot, or a direction reversed in ESC firmware
      when the flight controller owns direction. Checked per motor as each
      ESC first reports; an ESC that never reports is not a failure, so a
      bench session with no battery still runs. Turn this off only to bring
      up an ESC whose settings are known wrong.

endmenu

