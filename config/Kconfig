menu "Buzzer"

config ESP32_BUZZER_ACTIVE_LOW
    bool "Active low"
    default n
    help
      Invert the buzzer output polarity. Enable this when the buzzer hardware
      is active when the drive signal is low.

menu "LEDC"

config ESP32_BUZZER_LEDC_TIMER
    int "LEDC timer"
    range 0 3
    default 1
    help
      Which LEDC timer drives the buzzer. Must not collide with the LED's.

config ESP32_BUZZER_LEDC_CHANNEL
    int "LEDC channel"
    range 0 5
    default 1
    help
      Which LEDC channel drives the buzzer. Must not collide with the LED's.

config ESP32_BUZZER_LEDC_DUTY_RES_BITS
    int "LEDC duty resolution (bits)"
    range 1 14
    default 10
    help
      Volume steps are 2^bits. TonePlayer maps its volume onto this range, and
      the highest note it can play has to fit freq * 2^bits within the LEDC
      clock.

config ESP32_BUZZER_MAX_NOTE_HZ
    int "Highest note (Hz)"
    range 100 20000
    default 20000
    help
      Ceiling on the frequency the buzzer is driven at: the top of human
      hearing. LEDC needs freq * 2^duty_res to stay within its clock, so the
      build rejects a pair that cannot both be met and the driver clamps
      anything above this.

endmenu

endmenu

