menu "Peripherals"

menu "RCC"

# Clock tree configuration consumed by System::Init(). Values are emitted
# into board::kSystemDefault by the generator and translated to HAL bit
# patterns inside system.cpp.
#
# Not every (PLLM, PLLN, PLLP, AHB/APB div, flash latency, voltage scale)
# combination is valid. The generator checks the PLL VCO ranges and the
# SYSCLK ceiling and aborts the build; max bus frequencies, latency vs
# SYSCLK and voltage scale vs target clock are still yours to check.
# Consult RM0090 §6 before changing defaults.

choice
    prompt "Oscillator source"
    default STM32_RCC_OSC_HSE

config STM32_RCC_OSC_HSE
    bool "HSE (external crystal)"

config STM32_RCC_OSC_HSI
    bool "HSI (16 MHz internal RC)"

endchoice

config STM32_RCC_HSE_HZ
    int "HSE crystal frequency (Hz)"
    range 4000000 26000000
    default 8000000
    help
      The crystal fitted to your board; the DevEBox STM32F4XX_M has 8 MHz. A
      wrong value still boots — the PLL runs off the real crystal either way —
      but every clock derived from it is off by the ratio of the two.

config STM32_RCC_PLL_M
    int "PLLM (input divider, 2..63)"
    range 2 63
    default 8

config STM32_RCC_PLL_N
    int "PLLN (VCO multiplier, 50..432)"
    range 50 432
    default 336

choice
    prompt "PLLP (SYSCLK divider)"
    default STM32_RCC_PLL_P_DIV2

config STM32_RCC_PLL_P_DIV2
    bool "/2"
config STM32_RCC_PLL_P_DIV4
    bool "/4"
config STM32_RCC_PLL_P_DIV6
    bool "/6"
config STM32_RCC_PLL_P_DIV8
    bool "/8"

endchoice

config STM32_RCC_PLL_Q
    int "PLLQ (USB/SDIO divider, 2..15)"
    range 2 15
    default 7
    help
      Divides the PLL VCO to clock USB, SDIO and the RNG. It does not affect
      the CPU or any bus. USB device mode only works when this lands on
      exactly 48 MHz: with the stock 8 MHz crystal the VCO is 336 MHz, so
      PLLQ must be 7. Change it only if you have altered PLLM or PLLN and
      recomputed VCO / PLLQ = 48000000.

choice
    prompt "AHB divider"
    default STM32_RCC_AHB_DIV1

config STM32_RCC_AHB_DIV1
    bool "/1"
config STM32_RCC_AHB_DIV2
    bool "/2"
