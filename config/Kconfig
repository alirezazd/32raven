menu "Peripherals"

menu "LED"

config ESP32_LED_ACTIVE_LOW
    bool "Active low"
    default y
    help
      Invert the LED logical state. Enable this when driving the LED low turns
      it on.

menu "LEDC"

config ESP32_LED_LEDC_TIMER
    int "LEDC timer"
    range 0 3
    default 0
    help
      Which LEDC timer drives the LED. Timers are a shared resource: the
      build refuses a configuration where two consumers claim the same one,
      because the second to initialise silently retunes the first.

config ESP32_LED_LEDC_CHANNEL
    int "LEDC channel"
    range 0 5
    default 0
    help
      Which LEDC channel drives the LED. Checked for collisions alongside
      the timer.

config ESP32_LED_LEDC_DUTY_RES_BITS
    int "LEDC duty resolution (bits)"
    range 1 14
    default 13
    help
      Brightness steps are 2^bits. The build rejects a resolution the carrier
      frequency cannot reach, since freq * 2^bits must stay within the LEDC
      clock.

config ESP32_LED_LEDC_FREQ_HZ
    int "LEDC carrier frequency (Hz)"
    range 100 40000000
    default 5000
    help
      PWM carrier for LED brightness. Well above the flicker threshold and
      bounded by the duty resolution above.

endmenu

endmenu

