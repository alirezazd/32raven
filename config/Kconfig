config STM32_RC_RECEIVER_CRSF_HEARTBEAT_PERIOD_MS
    int "Period (ms)"
    range 0 60000
    default 1000
    help
      Interval between CRSF heartbeat frames sent from the flight controller
      back through the RC receiver. Set to 0 to disable heartbeat telemetry.

config STM32_RC_RECEIVER_CRSF_HEARTBEAT_PRIORITY
    int "Priority"
    range 0 15
    default 15
    help
      Relative priority used when several CRSF telemetry items are due at the
      same time. Higher values win.

endmenu

