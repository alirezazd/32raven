    bool "/4"
config STM32_RCC_AHB_DIV8
    bool "/8"
config STM32_RCC_AHB_DIV16
    bool "/16"
config STM32_RCC_AHB_DIV64
    bool "/64"
config STM32_RCC_AHB_DIV128
    bool "/128"
config STM32_RCC_AHB_DIV256
    bool "/256"
config STM32_RCC_AHB_DIV512
    bool "/512"

