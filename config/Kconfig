menu "STM32"

menu "Pin Map"

# Per-peripheral pin assignments validated against ST's open-pin-data XML.
# Each `choice` only lists (pin, AF) combos ST published as valid for that
# signal on the STM32F407V package. The selected entry is rendered into
# `board::k<Name>` constants by scripts/generate_stm32_config.py. Add a new
# peripheral by adding a choice block here AND a PinmapEntry in
# generate_stm32_config.py.
#
# Layout: Peripheral family (UART, SPI, TIM, ...) -> Instance (UART2, ...) ->
# Per-signal choice. Mirrors the silicon hierarchy and keeps related signals
# colocated as more peripherals come online.

menu "User I/O"

# Plain GPIOs (no alternate function). Any pin on a package-available port is
# valid; the generator validates the combo against pin_constraints.

menu "LED"

choice
    prompt "Port"
    default STM32_USER_LED_PORT_A

config STM32_USER_LED_PORT_A
    bool "GPIOA"
config STM32_USER_LED_PORT_B
    bool "GPIOB"
config STM32_USER_LED_PORT_C
    bool "GPIOC"
config STM32_USER_LED_PORT_D
    bool "GPIOD"
config STM32_USER_LED_PORT_E
    bool "GPIOE"

endchoice

config STM32_USER_LED_PIN
    int "Pin (0-15)"
    range 0 15
    default 1

endmenu

menu "Button"

choice
    prompt "Port"
    default STM32_USER_BTN_PORT_A

config STM32_USER_BTN_PORT_A
    bool "GPIOA"
config STM32_USER_BTN_PORT_B
    bool "GPIOB"
config STM32_USER_BTN_PORT_C
    bool "GPIOC"
config STM32_USER_BTN_PORT_D
    bool "GPIOD"
config STM32_USER_BTN_PORT_E
    bool "GPIOE"

endchoice

config STM32_USER_BTN_PIN
    int "Pin (0-15)"
    range 0 15
    default 0

endmenu

