menu "UART"

menu "USART1 (FcLink)"

# The link to the ESP32 bridge. PA9/PA10 is also the pair the STM32's ROM
# bootloader listens on, which is what lets the bridge flash the flight
# computer over the same wires it talks to it on. Moving this off the default
# keeps the link working but costs over-the-air flashing.

choice
    prompt "TX pin"
    default STM32_UART1_TX_PIN_PA9

