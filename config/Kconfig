menu "USB CDC"

# Identity the STM32 presents on its USB device port. Host-side ESC and
# flight-controller configurators are browser tools that reach the board over
# Web Serial, which filters the port list by USB vendor ID — so these values
# decide whether the board is offered to the user at all, not just how it is
# labelled.

config STM32_USB_VENDOR_ID
    hex "Vendor ID"
    range 0x0 0xFFFF
    default 0x0483
    help
      USB idVendor reported in the device descriptor. Defaults to
      STMicroelectronics (0x0483), the ID whose virtual COM port every
      mainstream flight-controller configurator already allow-lists. Changing
      this makes the board invisible to those tools unless their filters are
      changed to match.

config STM32_USB_PRODUCT_ID
    hex "Product ID"
    range 0x0 0xFFFF
    default 0x5740
    help
      USB idProduct reported in the device descriptor. Defaults to ST's
      virtual COM port (0x5740), which pairs with the default vendor ID to
      form the identity configurators recognise.

config STM32_USB_MANUFACTURER
    string "Manufacturer string"
    default "32Raven"
    help
      iManufacturer string descriptor. Cosmetic — shown by lsusb and in the
      host's device listing.

config STM32_USB_PRODUCT
    string "Product string"
    default "32Raven Virtual COM Port"
    help
      iProduct string descriptor. Cosmetic — shown by lsusb and in the host's
      port picker alongside the serial number.

endmenu

