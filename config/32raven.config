CONFIG_STM32_ESC_TLM_RX_PIN_PB11=y
# CONFIG_STM32_ESC_TLM_RX_PIN_PD9 is not set
# end of USART3 (ESC Telemetry RX)

#
# USART6 (RC Receiver)
#

#
# PC6/PC7 are fixed: the package bonds out no other USART6 pair
#
CONFIG_STM32_UART6_TX_PIN_PC6=y
CONFIG_STM32_UART6_RX_PIN_PC7=y
# end of USART6 (RC Receiver)
# end of UART

#
# USB (OTG FS Device)
#

#
# PA11/PA12 are fixed: the package bonds out no other OTG FS pair
#
CONFIG_STM32_USB_DM_PIN_PA11=y
CONFIG_STM32_USB_DP_PIN_PA12=y
# end of USB (OTG FS Device)

#
# SD Card (SDIO)
#

#
# PC8-PC12/PD2 are fixed: the package bonds out no other SDIO group
#
CONFIG_STM32_SDIO_D0_PIN_PC8=y
CONFIG_STM32_SDIO_D1_PIN_PC9=y
CONFIG_STM32_SDIO_D2_PIN_PC10=y
CONFIG_STM32_SDIO_D3_PIN_PC11=y
CONFIG_STM32_SDIO_CK_PIN_PC12=y
CONFIG_STM32_SDIO_CMD_PIN_PD2=y
