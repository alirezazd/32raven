# CONFIG_STM32_RCC_APB1_DIV16 is not set
# CONFIG_STM32_RCC_APB2_DIV1 is not set
CONFIG_STM32_RCC_APB2_DIV2=y
# CONFIG_STM32_RCC_APB2_DIV4 is not set
# CONFIG_STM32_RCC_APB2_DIV8 is not set
# CONFIG_STM32_RCC_APB2_DIV16 is not set
CONFIG_STM32_RCC_VOLTAGE_SCALE1=y
