CONFIG_STM32_GPS_M10_UART_ENABLED=y
# CONFIG_STM32_GPS_M10_BAUD_9600 is not set
# CONFIG_STM32_GPS_M10_BAUD_19200 is not set
# CONFIG_STM32_GPS_M10_BAUD_38400 is not set
