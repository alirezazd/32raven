#
CONFIG_STM32_UART1_TX_PIN_PA9=y
# CONFIG_STM32_UART1_TX_PIN_PB6 is not set
CONFIG_STM32_UART1_RX_PIN_PA10=y
# CONFIG_STM32_UART1_RX_PIN_PB7 is not set
# end of USART1 (FcLink)

