# Build Artifacts
# Unanchored on purpose: also catches accidental in-source builds (stm32/build/,
# esp32/build/). The negation rescues the handbook's build-guide section, which
# would otherwise be silently dropped from every commit.
build/
!docs/build/
.docker/
.build-mode
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
*.elf
*.bin
*.map
*.o
*.a
*.log

# Docs (mkdocs build output)
site/

# Editors & OS
.vscode/
.idea/
.DS_Store
*~
*.swp
*.swo

# ESP-IDF
managed_components/
.espressif/
flasher_args.json

# Python
__pycache__/
venv/
.venv/
*.pyc

# Kconfig / menuconfig artifacts
config/32raven.config.old
config/defconfig

# STM32
mx.scratch
*.ioc
!32Raven.ioc
user_config.cmake
esp32/main/esp32_config.hpp
esp32/main/esp32_limits.hpp
stm32/Drivers/Inc/stm32_config.hpp
stm32/Drivers/Inc/stm32_limits.hpp
stm32/Drivers/Inc/ee_schema.hpp

# Stray in-source CMake output (the real configure goes to build/). CMakeFiles/
# and cmake_install.cmake are already ignored above; this covers the Makefile a
# top-level in-source `cmake` would drop next to the cubemx CMakeLists.
stm32/cmake/stm32cubemx/Makefile


# Temporary files
.temp/
